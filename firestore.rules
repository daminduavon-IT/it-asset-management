rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The main administrator (admin@avonpc.com). Always an administrator, even without a profile, so the
    // system can never be left without one. src/constants/accounts.ts names the same account id.
    function isOwner() {
      return signedIn() && request.auth.uid == 'UUE8izuqOKfHicvF08dbZwrhTAx2';
    }

    // Every other account gets its access from its profile, users/{uid}, which only administrators can write.
    // A sign-in without an active profile (never added in the app, or access removed) can read and change nothing.
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profileRole() {
      return exists(profilePath()) && get(profilePath()).data.active == true
        ? get(profilePath()).data.role
        : 'none';
    }

    function role() {
      return !signedIn() ? 'none' : (isOwner() ? 'admin' : profileRole());
    }

    function isAdmin() {
      return role() == 'admin';
    }

    // Auditors (e.g. the ISO auditor) can view everything but change nothing
    function canView() {
      return role() in ['admin', 'editor', 'auditor'];
    }

    function canEdit() {
      return role() in ['admin', 'editor'];
    }

    // 1. Assets
    match /assets/{assetId} {
      allow read: if canView();
      allow write: if canEdit();
    }

    // 2. Service Logs
    match /service_logs/{logId} {
      allow read: if canView();
      allow write: if canEdit();
    }

    // 3. Login Logs: every sign-in records its own logins and may only add its own logout time;
    //    history cannot be rewritten or deleted
    match /login_logs/{logId} {
      allow read: if canView();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logoutTime']);
      allow delete: if false;
    }

    // 4. Activity Logs (immutable): written by accounts that change data; never edited or deleted
    match /activity_logs/{logId} {
      allow read: if canView();
      allow create: if canEdit();
      allow update, delete: if false;
    }

    // 5. User accounts: administrators add them and change role or access; everyone can read their own.
    //    Profiles are never deleted (access is switched off instead), and the main administrator's stays as it is.
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'editor', 'auditor']
        && request.resource.data.active is bool
        && request.resource.data.name is string
        && request.resource.data.email is string
        && (userId != 'UUE8izuqOKfHicvF08dbZwrhTAx2'
            || (request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if false;
    }
  }
}
