# Copy to .env and fill in from Firebase Console → Project settings → General → Your apps (web app config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local testing only: "true" points the app at the Firebase emulators (auth :9099, firestore :8080)
VITE_USE_FIREBASE_EMULATORS=
